<?xml version="1.0" encoding="utf-8"?>
<!-- Compare-mode row (v1.26): mirrors item_stable but without copy/explore
     buttons, per the compare mockup — checkbox, rank, IP, tag, ms. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/result_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <CheckBox
        android:id="@+id/cbSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/rank_bg"
        android:gravity="center"
        android:text="1"
        android:textColor="#0A0A0B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="8.34.146.207:500"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/gray"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:padding="5dp"
        android:text="64 ms"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
